{
  "name": "glyphisland",
  "version": "1.0.0",
  "private": true,
  "description": "A Nothing OS inspired desktop status capsule and focus widget.",
  "main": "dist-electron/main.js",
  "author": "GlyphIsland",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.electron.json",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.electron.json",
    "pack:win": "npm run build && electron-builder --win portable --x64 --config.win.signAndEditExecutable=false",
    "pack:linux": "npm run build && electron-builder --linux AppImage --x64",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "framer-motion": "^11.18.2",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "systeminformation": "^5.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "studio.glyphisland.desktop",
    "productName": "GlyphIsland",
    "directories": { "output": "release" },
    "files": ["dist/**", "dist-electron/**", "package.json"],
    "asar": true,
    "artifactName": "GlyphIsland-${platform}.${ext}",
    "win": { "target": [{ "target": "portable", "arch": ["x64"] }] },
    "portable": { "artifactName": "GlyphIsland-Windows.${ext}" },
    "linux": {
      "target": [{ "target": "AppImage", "arch": ["x64"] }],
      "category": "Utility",
      "artifactName": "GlyphIsland-Linux.${ext}"
    }
  }
}
